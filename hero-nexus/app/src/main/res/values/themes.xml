<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Heronexus" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/combat_red</item>
        <item name="colorPrimaryVariant">@color/combat_red_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorSecondary">@color/reward_gold</item>
        <item name="colorOnSecondary">@color/bg_deep_blue</item>
        <item name="android:colorBackground">@color/bg_deep_blue</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorOnSurface">@color/text_white</item>
        <item name="colorOnBackground">@color/text_white</item>
        <item name="android:statusBarColor">@color/bg_deep_blue</item>
        <item name="android:navigationBarColor">@color/bg_deep_blue</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Theme.Heronexus" parent="Base.Theme.Heronexus" />

    <style name="Theme.Heronexus.Splash" parent="Base.Theme.Heronexus">
        <item name="android:windowBackground">@color/bg_deep_blue</item>
    </style>

    <style name="TextAppearance.Heronexus.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/bebas_neue</item>
        <item name="android:fontFamily">@font/bebas_neue</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">@dimen/text_size_title</item>
    </style>

    <style name="TextAppearance.Heronexus.ButtonLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/bebas_neue</item>
        <item name="android:fontFamily">@font/bebas_neue</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Heronexus.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/bebas_neue</item>
        <item name="android:fontFamily">@font/bebas_neue</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">@dimen/text_size_title</item>
    </style>

    <style name="TextAppearance.Heronexus.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
    </style>

    <style name="TextAppearance.Heronexus.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <style name="TextAppearance.Heronexus.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_size_label</item>
    </style>

    <style name="TextAppearance.Heronexus.Micro" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_size_micro</item>
    </style>

    <style name="TextAppearance.Heronexus.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/text_white</item>
        <item name="fontFamily">@font/bebas_neue</item>
        <item name="android:fontFamily">@font/bebas_neue</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/text_size_display</item>
    </style>

    <style name="TextAppearance.Heronexus.HudReadout" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_hud_readout</item>
    </style>

    <style name="TextAppearance.Heronexus.HudBanner" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_hud_banner</item>
    </style>

    <style name="TextAppearance.Heronexus.HudFlash" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/bebas_neue</item>
        <item name="android:fontFamily">@font/bebas_neue</item>
        <item name="android:textSize">@dimen/text_size_hud_flash</item>
    </style>

    <style name="TextAppearance.Heronexus.StatValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_size_stat_value</item>
    </style>

    <style name="Widget.Heronexus.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/combat_red</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/reward_gold</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.Heronexus.Button.Gold" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/reward_gold</item>
        <item name="android:textColor">@color/bg_deep_blue</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
