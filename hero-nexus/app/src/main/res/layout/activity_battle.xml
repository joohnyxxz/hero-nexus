<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_blue"
    android:keepScreenOn="true">

    <com.app.hero_nexus.ui.battle.BattleView
        android:id="@+id/battleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_s">

        <ImageButton
            android:id="@+id/buttonExit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@android:string/cancel"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                tools:text="Homem-Aranha" />

            <ProgressBar
                android:id="@+id/progressPlayerHealth"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="@dimen/hud_bar_height"
                android:layout_marginStart="@dimen/spacing_s"
                android:max="100"
                android:progressDrawable="@drawable/progress_health_bar"
                tools:progress="80" />
        </LinearLayout>

        <TextView
            android:id="@+id/textEnemiesDefeated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_m"
            android:textColor="@color/text_white"
            tools:text="Inimigos: 3" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_coin" />

        <TextView
            android:id="@+id/textCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/reward_gold"
            android:textStyle="bold"
            tools:text="120" />
    </LinearLayout>

    <!-- Barra de vida do chefe -->
    <LinearLayout
        android:id="@+id/layoutBossHealth"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/textBossName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rarity_boss"
            android:textStyle="bold"
            tools:text="DUENDE VERDE" />

        <ProgressBar
            android:id="@+id/progressBossHealth"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hud_bar_height"
            android:max="100"
            android:progressDrawable="@drawable/progress_boss_health_bar"
            tools:progress="70" />
    </LinearLayout>

    <!-- Banner de eventos (troca de personagem, chefe chegando, etc.) -->
    <TextView
        android:id="@+id/textBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/scrim"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingVertical="@dimen/spacing_s"
        android:textColor="@color/reward_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="DUENDE VERDE DERROTADO"
        tools:visibility="visible" />

    <!-- Joystick virtual -->
    <FrameLayout
        android:id="@+id/joystickArea"
        android:layout_width="@dimen/joystick_size"
        android:layout_height="@dimen/joystick_size"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/spacing_l">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_joystick_base" />

        <View
            android:id="@+id/joystickKnob"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_joystick_knob" />
    </FrameLayout>

    <!-- Botão de ataque -->
    <View
        android:id="@+id/buttonAttack"
        android:layout_width="@dimen/attack_button_size"
        android:layout_height="@dimen/attack_button_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_l"
        android:background="@drawable/bg_attack_button" />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="42dp"
        android:src="@drawable/ic_sword" />

</FrameLayout>
