<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_blue"
    android:keepScreenOn="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.app.hero_nexus.ui.battle.BattleView
        android:id="@+id/battleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/layoutHudTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_s">

        <ImageButton
            android:id="@+id/buttonExit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@android:string/cancel"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Heronexus.HudReadout"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                tools:text="Homem-Aranha" />

            <ProgressBar
                android:id="@+id/progressPlayerHealth"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="@dimen/hud_bar_height"
                android:layout_marginStart="@dimen/spacing_s"
                android:max="100"
                android:progressDrawable="@drawable/progress_health_bar"
                tools:progress="80" />
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/spacing_m"
            android:src="@drawable/ic_coin" />

        <TextView
            android:id="@+id/textCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textAppearance="@style/TextAppearance.Heronexus.HudReadout"
            android:textColor="@color/reward_gold"
            android:textStyle="bold"
            tools:text="120" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBossHealth"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/textBossName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Heronexus.HudReadout"
            android:textColor="@color/rarity_boss"
            android:textStyle="bold"
            tools:text="DUENDE VERDE" />

    </LinearLayout>

    <TextView
        android:id="@+id/textBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/scrim"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingVertical="@dimen/spacing_s"
        android:textAppearance="@style/TextAppearance.Heronexus.HudBanner"
        android:textColor="@color/reward_gold"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="DUENDE VERDE DERROTADO"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/joystickArea"
        android:layout_width="@dimen/joystick_size"
        android:layout_height="@dimen/joystick_size"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/spacing_l">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_joystick_base" />

        <View
            android:id="@+id/joystickKnob"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_joystick_knob" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/buttonAttack"
        android:clickable="true"
        android:layout_width="@dimen/attack_button_size"
        android:layout_height="@dimen/attack_button_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_l"
        android:background="@drawable/bg_attack_button">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_fist" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/buttonSpecial"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/spacing_l"
        android:layout_marginBottom="118dp"
        android:background="@drawable/bg_special_button">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_special" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="182dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/pipSpecial1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="5dp"
            android:alpha="0.28"
            android:background="@drawable/bg_special_pip" />

        <View
            android:id="@+id/pipSpecial2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:alpha="0.28"
            android:background="@drawable/bg_special_pip" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/buttonFood"
        android:clickable="true"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="114dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_food_button"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_food" />

        <TextView
            android:id="@+id/textFoodCount"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-6dp"
            android:layout_marginEnd="-6dp"
            android:background="@drawable/bg_food_count_badge"
            android:gravity="center"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_size_micro"
            android:textStyle="bold"
            tools:text="3" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_battle_transition"
        android:clickable="true"
        android:focusable="true" />

    <FrameLayout
        android:id="@+id/minibossFlashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0"
        android:visibility="gone">

        <TextView
            android:id="@+id/textMinibossDefeated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textAppearance="@style/TextAppearance.Heronexus.HudFlash"
            android:letterSpacing="0.04"
            android:textColor="@color/reward_gold"
            android:textStyle="bold"
            tools:text="CHEFE DA GANGUE DERROTADO!" />
    </FrameLayout>

</FrameLayout>
