<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_blue"
    android:keepScreenOn="true">

    <com.app.hero_nexus.ui.battle.BattleView
        android:id="@+id/battleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_s">

        <ImageButton
            android:id="@+id/buttonExit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@android:string/cancel"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                tools:text="Homem-Aranha" />

            <ProgressBar
                android:id="@+id/progressPlayerHealth"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="@dimen/hud_bar_height"
                android:layout_marginStart="@dimen/spacing_s"
                android:max="100"
                android:progressDrawable="@drawable/progress_health_bar"
                tools:progress="80" />
        </LinearLayout>

        <!-- Rodada 13 (feedback 01/09: "sem contador de quantos inimigos" , mais nostálgico
             sem esse número piscando, o jogador só sente a dificuldade jogando). -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/spacing_m"
            android:src="@drawable/ic_coin" />

        <TextView
            android:id="@+id/textCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/reward_gold"
            android:textStyle="bold"
            tools:text="120" />
    </LinearLayout>

    <!-- Barra de vida do chefe -->
    <LinearLayout
        android:id="@+id/layoutBossHealth"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/textBossName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rarity_boss"
            android:textStyle="bold"
            tools:text="DUENDE VERDE" />

        <ProgressBar
            android:id="@+id/progressBossHealth"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hud_bar_height"
            android:max="100"
            android:progressDrawable="@drawable/progress_boss_health_bar"
            tools:progress="70" />
    </LinearLayout>

    <!-- Banner de eventos (troca de personagem, chefe chegando, etc.) -->
    <TextView
        android:id="@+id/textBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/scrim"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingVertical="@dimen/spacing_s"
        android:textColor="@color/reward_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="DUENDE VERDE DERROTADO"
        tools:visibility="visible" />

    <!-- Joystick virtual -->
    <FrameLayout
        android:id="@+id/joystickArea"
        android:layout_width="@dimen/joystick_size"
        android:layout_height="@dimen/joystick_size"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/spacing_l">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_joystick_base" />

        <View
            android:id="@+id/joystickKnob"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_joystick_knob" />
    </FrameLayout>

    <!-- Botão de ataque -->
    <View
        android:id="@+id/buttonAttack"
        android:layout_width="@dimen/attack_button_size"
        android:layout_height="@dimen/attack_button_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_l"
        android:background="@drawable/bg_attack_button" />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="42dp"
        android:src="@drawable/ic_sword" />

    <!-- Botão de especial: carrega com o dano causado (barrinha fina embaixo), guarda até 2 usos
         prontos (pips ao lado): seção "especial", feedback 31/08. -->
    <FrameLayout
        android:id="@+id/buttonSpecial"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/spacing_l"
        android:layout_marginBottom="118dp"
        android:background="@drawable/bg_special_button">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_special" />

        <ProgressBar
            android:id="@+id/progressSpecialCharge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="42dp"
            android:layout_height="5dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="7dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_special_charge"
            tools:progress="40" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="182dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/pipSpecial1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="5dp"
            android:alpha="0.28"
            android:background="@drawable/bg_special_pip" />

        <View
            android:id="@+id/pipSpecial2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:alpha="0.28"
            android:background="@drawable/bg_special_pip" />
    </LinearLayout>

    <!-- Botão de comida: só aparece quando tem algo guardado no slot. O jogador decide a hora
         de comer, em vez de curar automaticamente ao quebrar a caixa/barril. -->
    <FrameLayout
        android:id="@+id/buttonFood"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="92dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_food_button"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_food" />

        <!-- Contador de cargas guardadas (0-3, rodada 13: "o slot para cura seria de 3
             comidinhas"). -->
        <TextView
            android:id="@+id/textFoodCount"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:background="@drawable/bg_food_count_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="3" />
    </FrameLayout>

    <!-- Overlay de carregamento: tela escura em degradê (sem spinner/texto: feedback 31/08:
         "mais nostálgico só ir pra tela preta com uma transição, tipo de gradient") que some com
         um fade suave assim que a arena está pronta (ver BattleActivity.dismissLoadingOverlay). -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_battle_transition"
        android:clickable="true"
        android:focusable="true" />

    <!-- Flash de miniboss derrotado: tela preta rápida, luta continua por baixo (feedback
         01/09: "sabe em golden axe? vc mata um vilão, aparece uma tela preta mas ainda
         continua na batalha, acho que deveria ser mais desafiante"). Sem clickable/focusable ,
         diferente do loadingOverlay, esse não deve bloquear toque nenhum instante a mais que o
         necessário, o jogo tá rolando por baixo o tempo todo. -->
    <FrameLayout
        android:id="@+id/minibossFlashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0"
        android:visibility="gone">

        <TextView
            android:id="@+id/textMinibossDefeated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/bebas_neue"
            android:letterSpacing="0.04"
            android:textColor="@color/reward_gold"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="CHEFE DA GANGUE DERROTADO!" />
    </FrameLayout>

</FrameLayout>
