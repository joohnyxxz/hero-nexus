<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/card_width"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_s"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="2.5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageCharacter"
            android:layout_width="0dp"
            android:layout_height="@dimen/card_image_height"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_character_placeholder" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/overlay_card_vignette"
            app:layout_constraintBottom_toBottomOf="@id/imageCharacter"
            app:layout_constraintEnd_toEndOf="@id/imageCharacter"
            app:layout_constraintStart_toStartOf="@id/imageCharacter"
            app:layout_constraintTop_toTopOf="@id/imageCharacter" />

        <View
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_gradient_scrim"
            app:layout_constraintBottom_toBottomOf="@id/imageCharacter"
            app:layout_constraintEnd_toEndOf="@id/imageCharacter"
            app:layout_constraintStart_toStartOf="@id/imageCharacter" />

        <!-- Rodada 15, parte 61 (07/10/2026): pedido do usuario: "a carta cinza se nao tiver
             desbloqueado". Antes só a FOTO ficava em escala de cinza (ColorMatrix no
             CharacterAdapter); moldura, cabeçalho e selo de raridade continuavam coloridos,
             entregando de bandeja a raridade de um personagem ainda bloqueado. Este véu escuro
             (visível só quando bloqueado, ver CharacterAdapter) cobre a ilustração inteira por
             cima da foto já acinzentada, reforçando a sensação de "carta selada". -->
        <View
            android:id="@+id/viewLockedScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/locked_overlay"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/imageCharacter"
            app:layout_constraintEnd_toEndOf="@id/imageCharacter"
            app:layout_constraintStart_toStartOf="@id/imageCharacter"
            app:layout_constraintTop_toTopOf="@id/imageCharacter"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_card_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/imageCharacter"
            app:layout_constraintStart_toStartOf="@id/imageCharacter"
            app:layout_constraintTop_toTopOf="@id/imageCharacter">

            <TextView
                android:id="@+id/textRarity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:fontFamily="@font/bebas_neue"
                android:letterSpacing="0.05"
                android:textColor="@color/bg_deep_blue"
                android:textSize="@dimen/text_size_label"
                android:textStyle="bold"
                tools:text="RARO" />

            <TextView
                android:id="@+id/textLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:fontFamily="@font/bebas_neue"
                android:letterSpacing="0.02"
                android:textColor="@color/bg_deep_blue"
                android:textSize="@dimen/text_size_label"
                android:textStyle="bold"
                tools:text="Nv. 7" />
        </LinearLayout>

        <TextView
            android:id="@+id/textName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/bebas_neue"
            android:letterSpacing="0.02"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/imageCharacter"
            app:layout_constraintEnd_toStartOf="@id/imageRarityGem"
            app:layout_constraintStart_toStartOf="@id/imageCharacter"
            tools:text="Homem-Aranha" />

        <ImageView
            android:id="@+id/imageLock"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_rarity_gem"
            android:backgroundTint="#8A000000"
            android:padding="7dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/imageCharacter"
            app:layout_constraintEnd_toEndOf="@id/imageCharacter"
            app:layout_constraintStart_toStartOf="@id/imageCharacter"
            app:layout_constraintTop_toTopOf="@id/imageCharacter"
            app:srcCompat="@drawable/ic_lock"
            app:tint="@color/text_white"
            tools:visibility="visible" />

        <!-- Selo de raridade: pedido do usuário, "algum detalhe mostrando a raridade da
             cartinha": um círculo colorido (cor da raridade, tintada em CharacterAdapter), no
             canto oposto ao nome, além da faixa de texto que já existia no topo (headerBar). -->
        <ImageView
            android:id="@+id/imageRarityGem"
            android:layout_width="@dimen/card_rarity_gem_size"
            android:layout_height="@dimen/card_rarity_gem_size"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_rarity_gem"
            android:padding="5dp"
            app:layout_constraintBottom_toBottomOf="@id/imageCharacter"
            app:layout_constraintEnd_toEndOf="@id/imageCharacter"
            app:srcCompat="@drawable/ic_star"
            app:tint="@color/bg_deep_blue"
            tools:ignore="ContentDescription" />

        <!-- Cor de fundo trocada em tempo de execução (CharacterAdapter) pela mesma cor da
             raridade/moldura do card; o tools:background abaixo é só o que aparece no
             preview do Android Studio antes de bindar. -->
        <View
            android:id="@+id/dividerStats"
            android:layout_width="0dp"
            android:layout_height="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageCharacter"
            tools:background="@color/card_stroke_gold" />

        <LinearLayout
            android:id="@+id/layoutStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_stat_chip"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerStats">

            <!-- Rodada 15, parte 63 (07/10/2026): a estrela da parte 62 acabou criando um
                 problema novo, percebido pelo usuário: a mesma forma (estrela) aparecendo
                 duas vezes na mesma carta (aqui e no selo de raridade, imageRarityGem acima),
                 só com cor/posição diferentes, lia como duplicado/confuso. ic_power_bars é um
                 ícone só dele, dedicado a "nível de poder" (3 barras crescentes), sem repetir
                 nenhuma forma já usada em outro lugar do card ou do app. -->
            <ImageView
                android:id="@+id/iconPower"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_power_bars"
                app:tint="@color/reward_gold" />

            <TextView
                android:id="@+id/textPower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/bebas_neue"
                android:letterSpacing="0.02"
                android:textColor="@color/reward_gold"
                android:textSize="@dimen/text_size_label"
                android:textStyle="bold"
                tools:text="82" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressXp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_xp_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutStats"
            tools:progress="40" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
